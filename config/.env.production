# =============================================================================
# MSSQL Connection Configuration
# =============================================================================

# Primary SQL Server Configuration
MSSQL_SERVER=""
MSSQL_PORT=""
MSSQL_DATABASE=""
MSSQL_USERNAME=""
MSSQL_PASSWORD=""
MSSQL_TRUSTED_CONNECTION=false

# TDS Protocol Configuration
TDS_VERSION=7.0

# Connection Options
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_CONNECTION_TIMEOUT=30
MSSQL_COMMAND_TIMEOUT=30

# =============================================================================
# Docker Environment Configuration
# =============================================================================

# Directories
RESULT_DIR=""
SQL_SCRIPT=""

# =============================================================================
# Advanced Configuration (Optional)
# =============================================================================

# Debugging and Logging
DEBUG_MODE=false
VERBOSE_LOGGING=false

# Driver Preferences (pyodbc, pymssql)
PREFERRED_DRIVER=pyodbc
FALLBACK_ENABLED=true

# SSL/TLS Configuration for Legacy Servers
OPENSSL_LEGACY_MODE=true
SSL_VERIFY=false
SSL_MIN_PROTOCOL=None
SSL_MAX_PROTOCOL=None

# FreeTDS Specific Configuration
FREETDS_CHARSET=UTF-8
FREETDS_TEXT_SIZE=2147483647
FREETDS_ENCRYPTION=off
FREETDS_USE_NTLMV2=no
FREETDS_ENABLE_KRB5=no