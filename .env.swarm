# =============================================================================
# DOCKER SWARM ENVIRONMENT CONFIGURATION
# Este arquivo pode sobrescrever configurações específicas para Swarm
# =============================================================================

# Configurações específicas para Swarm
STACK_NAME=mssql-client-stack
IMAGE_NAME=mssql-pyodbc-client:latest

# Recursos do container
MEMORY_LIMIT=512M
MEMORY_RESERVATION=256M
CPU_LIMIT=0.5
CPU_RESERVATION=0.25

# Número de réplicas
REPLICAS=1

# Configurações de rede
NETWORK_DRIVER=overlay

# Configurações de volumes para Swarm
# Usar volumes nomeados ao invés de bind mounts para melhor portabilidade
USE_NAMED_VOLUMES=false

# Se usar volumes nomeados, configurar os drivers
VOLUME_DRIVER=local
